{
  "tasks": {
    "start": "deno run -A --env-file=.env main.ts",
    "dev": "deno run -A --watch --env-file=.env main.ts"
  },
  "fmt": {
    "singleQuote": true
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  },
  "imports": {
    "cloakbrowser": "npm:cloakbrowser@0.5.10",
    "playwright-core": "npm:playwright-core@1.55.0"
  }
}
